<?xml version="1.0" encoding="UTF-8"?>
<configuration debug="false">
    <springProperty name="spring.application.name" source="spring.application.name"/>
    <property name="log.home" value="/tmp/logs/app/${spring.application.name}"/>
    <property name="log.pattern"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [${spring.application.name},%X{trace_id:-}] [%0.30thread] %0.30logger{30} :%msg%n"/>

    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <pattern>${log.pattern}</pattern>
        </encoder>
    </appender>

    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <FileNamePattern>${log.home}/${HOSTNAME}.%d{yyyyMMddHH}.%i.log</FileNamePattern>
            <maxHistory>7</maxHistory>
            <maxFileSize>500MB</maxFileSize>
            <totalSizeCap>2GB</totalSizeCap>
        </rollingPolicy>
        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <pattern>${log.pattern}</pattern>
        </encoder>
    </appender>

    <appender name="ASYNC" class="ch.qos.logback.classic.AsyncAppender">
        <includeCallerData>true</includeCallerData>
        <discardingThreshold>0</discardingThreshold>
        <queueSize>512</queueSize>
        <appender-ref ref="FILE"/>
    </appender>

    <logger name="cn.hdfk7" level="DEBUG"/>
    <logger name="com.alibaba.cloud.sentinel" level="WARN"/>
    <logger name="com.alibaba.csp" level="WARN"/>
    <logger name="com.alibaba.nacos" level="WARN"/>
    <logger name="com.zaxxer.hikari" level="WARN"/>
    <logger name="org.apache.catalina" level="WARN"/>
    <logger name="org.apache.coyote" level="WARN"/>
    <logger name="org.hibernate.validator" level="WARN"/>
    <logger name="org.redisson" level="WARN"/>
    <logger name="org.springframework.boot.actuate.endpoint.web.EndpointLinksResolver" level="WARN"/>
    <logger name="org.springframework.boot.web.embedded.tomcat" level="WARN"/>
    <logger name="org.springframework.cloud.commons.util.InetUtils" level="WARN"/>
    <logger name="org.springframework.data.repository.config" level="WARN"/>
    <logger name="org.springframework.web.servlet.DispatcherServlet" level="WARN"/>

    <root level="INFO">
        <appender-ref ref="STDOUT"/>
        <appender-ref ref="ASYNC"/>
    </root>
</configuration>
