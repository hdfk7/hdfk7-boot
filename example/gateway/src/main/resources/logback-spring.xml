<?xml version="1.0" encoding="UTF-8"?>
<configuration debug="false">
    <springProperty scope="context"
                    name="APP_NAME"
                    source="spring.application.name"/>

    <springProperty scope="context"
                    name="LOG_HOME"
                    source="LOG_HOME"
                    defaultValue="/app/logs"/>

    <property name="LOG_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [${APP_NAME}] [%thread] [trace:%X{trace_id},span:%X{span_id}] %logger{36} - %msg%n"/>

    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>
    </appender>

    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_HOME}/${HOSTNAME}.log</file>
        <immediateFlush>false</immediateFlush>

        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_HOME}/${HOSTNAME}.%d{yyyyMMdd}.%i.log.gz</fileNamePattern>
            <maxHistory>2</maxHistory>
            <maxFileSize>500MB</maxFileSize>
            <totalSizeCap>2GB</totalSizeCap>
        </rollingPolicy>

        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>
    </appender>

    <appender name="ASYNC" class="ch.qos.logback.classic.AsyncAppender">
        <queueSize>8192</queueSize>
        <discardingThreshold>20</discardingThreshold>
        <neverBlock>false</neverBlock>
        <includeCallerData>true</includeCallerData>
        <appender-ref ref="FILE"/>
    </appender>

    <logger name="cn.hdfk7" level="DEBUG"/>

    <logger name="com.alibaba.cloud.sentinel" level="WARN"/>
    <logger name="com.alibaba.csp" level="WARN"/>
    <logger name="com.alibaba.nacos" level="WARN"/>
    <logger name="com.alibaba.nacos.client.naming" level="ERROR"/>
    <logger name="org.springframework.cloud.commons.util.InetUtils" level="WARN"/>

    <root level="INFO">
        <appender-ref ref="STDOUT"/>
        <appender-ref ref="ASYNC"/>
    </root>
</configuration>
